---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag" | "pill" | "label";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
    {...rest}
  >
    {variant === "pill" && (
      <span class="eyebrow_dot" aria-hidden="true" />
    )}
    {variant === "default" && (
      <span class="eyebrow_marker" aria-hidden="true" />
    )}
    <Tag class:list={["eyebrow_text", variant === "pill" || variant === "label" ? "text-style-label" : "text-style-small"]}>
      {variant === "label" && "/ "}<Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-small);
      }
      &.pill {
        background-color: var(--background-2);
        border: var(--border-width) solid var(--background-3);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-round);
      }
      .eyebrow_dot {
        flex: none;
        width: 0.4375rem;
        aspect-ratio: 1;
        border-radius: var(--radius-round);
        background-color: var(--brand-500);
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
