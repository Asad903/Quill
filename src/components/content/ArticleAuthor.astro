---
import type { HTMLAttributes } from "astro/types";
import { initials, type Author } from "@/utils/sanity.ts";

type Props = HTMLAttributes<"aside"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Author to credit. */
  author: Author;
  /** Tags shown above the author card. */
  tags?: string[];
};

const { render = true, author, tags = [], class: className, ...rest } = Astro.props;
---

{render && author && (
  <aside class:list={["article-author_wrap", className]} {...rest}>
    {tags.length > 0 && (
      <ul class="article-author_tags">
        {tags.map((tag) => <li class="article-author_tag">{tag}</li>)}
      </ul>
    )}
    <div class="article-author_card">
      <span class="article-author_avatar" aria-hidden="true">{initials(author.name)}</span>
      <div class="article-author_text">
        <p class="article-author_name">{author.name}</p>
        <p class="article-author_role text-color-2">{author.role}</p>
        {author.bio && <p class="article-author_bio text-color-2">{author.bio}</p>}
      </div>
    </div>
  </aside>
)}

<style is:global>
  @layer components {
    .article-author_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .article-author_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .article-author_tag {
      padding: 0.35em 0.9em;
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      font-size: var(--text-small);
    }

    .article-author_card {
      display: flex;
      gap: var(--space-4);
      padding: var(--space-5);
      border: var(--border-width) solid var(--background-3);
      border-radius: var(--radius-main);
    }

    .article-author_avatar {
      flex: none;
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: var(--radius-round);
      background-color: var(--dark-900);
      color: var(--light-100);
      font-weight: var(--primary-semibold);
    }

    .article-author_name {
      font-weight: var(--primary-semibold);
    }

    .article-author_role,
    .article-author_bio {
      font-size: var(--text-small);
    }

    .article-author_bio {
      margin-top: var(--space-2);
      max-width: 52ch;
    }
  }
</style>
