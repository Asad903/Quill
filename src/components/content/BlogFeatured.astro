---
import type { HTMLAttributes } from "astro/types";
import { formatLongDate, imageUrl, initials, type PostSummary } from "@/utils/sanity.ts";

type Props = HTMLAttributes<"article"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Post to feature. */
  post: PostSummary | null;
};

const { render = true, post, class: className, ...rest } = Astro.props;
---

{render && post && (
  <article class:list={["blog-featured_wrap", className]} {...rest}>
    <div class="blog-featured_media">
      {post.coverImage && (
        <img
          class="blog-featured_image"
          src={imageUrl(post.coverImage, 1200, 900)}
          alt={post.coverImage.alt ?? ""}
          width="1200"
          height="900"
          fetchpriority="high"
        />
      )}
      <span class="blog-featured_badge text-style-label">Featured</span>
    </div>
    <div class="blog-featured_content">
      <p class="blog-featured_category text-style-label text-color-2">{post.category.title}</p>
      <h2 class="blog-featured_title">
        <a class="blog-featured_link" href={`/blog/${post.slug}`}>{post.title}</a>
      </h2>
      <p class="blog-featured_excerpt text-color-2">{post.excerpt}</p>
      <p class="blog-featured_author">
        <span class="blog-featured_avatar" aria-hidden="true">{initials(post.author.name)}</span>
        <span class="blog-featured_author_text">
          <span class="blog-featured_name">{post.author.name}</span>
          <span class="text-color-2">
            {formatLongDate(post.publishedAt)}{post.readTime && ` · ${post.readTime} min read`}
          </span>
        </span>
      </p>
    </div>
  </article>
)}

<style is:global>
  @layer components {
    .blog-featured_wrap {
      position: relative;
      display: grid;
      width: 100%;
      border: var(--border-width) solid var(--background-3);
      border-radius: var(--radius-main);
      overflow: clip;
      @media (width >= 48rem) {
        grid-template-columns: 1fr 1fr;
      }
    }

    .blog-featured_media {
      position: relative;
      min-height: 16rem;
      background-color: var(--brand-200);
    }

    .blog-featured_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .blog-featured_badge {
      position: absolute;
      inset: auto auto var(--space-4) var(--space-4);
      padding: 0.4em 0.9em;
      border-radius: var(--radius-round);
      background-color: var(--dark-900);
      color: var(--light-100);
    }

    .blog-featured_content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-3);
      padding: var(--space-6);
    }

    .blog-featured_title {
      font-size: var(--h2);
      font-weight: var(--primary-bold);
      line-height: var(--line-height-small);
      letter-spacing: var(--letter-spacing-snug);
      text-wrap: balance;
    }

    .blog-featured_link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .blog-featured_excerpt {
      max-width: 42ch;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
    }

    .blog-featured_author {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }

    .blog-featured_avatar {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--radius-round);
      background-color: var(--dark-900);
      color: var(--light-100);
      font-size: var(--text-small);
      font-weight: var(--primary-semibold);
    }

    .blog-featured_author_text {
      display: flex;
      flex-direction: column;
      font-size: var(--text-small);
    }

    .blog-featured_name {
      font-weight: var(--primary-semibold);
    }
  }
</style>
