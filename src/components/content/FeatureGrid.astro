---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

const icons = {
  layers: ["M12 2L2 7l10 5 10-5-10-5z", "M2 17l10 5 10-5", "M2 12l10 5 10-5"],
  database: [
    "M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5",
    "M3 12c0 1.7 4 3 9 3s9-1.3 9-3",
    "M21 5c0 1.7-4 3-9 3S3 6.7 3 5s4-3 9-3 9 1.3 9 3z",
  ],
  bolt: ["M13 2L3 14h9l-1 8 10-12h-9l1-8z"],
  shield: ["M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"],
  chart: ["M3 3v18h18", "M7 14l4-4 3 3 5-6"],
  code: ["M16 18l6-6-6-6", "M8 6l-6 6 6 6"],
} as const;

type Item = {
  /** Icon name. */
  icon: keyof typeof icons;
  /** Feature title. */
  title: string;
  /** Feature description. */
  text: string;
};

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Features to show. */
  items: Item[];
};

const { render = true, items, class: className, ...rest } = Astro.props;
---

{render && items.length > 0 && (
  <ul class:list={["feature-grid_wrap", className]} {...rest}>
    {items.map((item) => (
      <li class="feature-grid_item">
        <span class="feature-grid_icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {icons[item.icon].map((d) => <path d={d} />)}
          </svg>
        </span>
        <Heading tag="h3" variant="h5">{item.title}</Heading>
        <Paragraph variant="small" class="text-color-2">{item.text}</Paragraph>
      </li>
    ))}
  </ul>
)}

<style is:global>
  @layer components {
    .feature-grid_wrap {
      display: grid;
      gap: var(--space-4);
      width: 100%;
      @media (width >= 40rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .feature-grid_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5);
      border: var(--border-width) solid var(--background-3);
      border-radius: var(--radius-main);
    }

    .feature-grid_icon {
      display: grid;
      place-items: center;
      width: 2.75rem;
      aspect-ratio: 1;
      margin-bottom: var(--space-1);
      border-radius: var(--radius-medium);
      background-color: var(--brand-200);
      color: var(--dark-900);
      & svg {
        width: 1.375rem;
        fill: none;
        stroke: currentcolor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
    }

    .feature-grid_item :is(h3, p) {
      margin: 0;
    }
  }
</style>
