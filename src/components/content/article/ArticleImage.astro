---
import { imageUrl, type SanityImage } from "@/utils/sanity.ts";

type Props = { node: SanityImage };

const { node } = Astro.props;
---

<figure class="article-body_image">
  <img src={imageUrl(node, 1400)} alt={node.alt ?? ""} loading="lazy" />
  {node.caption && <figcaption>{node.caption}</figcaption>}
</figure>
