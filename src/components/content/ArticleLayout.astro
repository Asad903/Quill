---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;
---

{render && (
  <div class:list={["article-layout_wrap", className]} {...rest}>
    <div class="article-layout_aside"><slot name="aside" /></div>
    <div class="article-layout_main"><slot /></div>
  </div>
)}

<style is:global>
  @layer components {
    .article-layout_wrap {
      display: grid;
      gap: var(--space-6);
      width: 100%;
      @media (width >= 64rem) {
        grid-template-columns: 14rem minmax(0, 46rem);
        justify-content: center;
      }
    }

    .article-layout_aside {
      @media (width >= 64rem) {
        position: sticky;
        top: calc(var(--nav-height) + var(--space-5));
        align-self: start;
      }
    }

    .article-layout_main {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
  }
</style>
